# =============================================================================
# LunarVision Planetary Registration Suite - Production Environment Config
# =============================================================================
# Override weak defaults before deploying to production environments.

# 1. PostgreSQL + PostGIS Spatial Storage
POSTGRES_DB=lunarvision
POSTGRES_USER=lunar_admin
POSTGRES_PASSWORD=replace_with_strong_password_here
POSTGRES_HOST=lunarvision-postgis
POSTGRES_PORT=5432

# 2. MinIO S3-Compatible Object Store
MINIO_ACCESS_KEY=lunar_s3_admin
MINIO_SECRET_KEY=replace_with_strong_secret_key_here

# 3. LunarVision Deliverables & CORS Configuration
LUNARVISION_OUTPUT_DIR=/data/lunarvision_deliverables
LUNARVISION_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
